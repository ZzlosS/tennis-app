# Copy to .env.local (git-ignored) and fill in. Values starting with EXPO_PUBLIC_ are built into the app.

# Where the API lives, including /v1. A local backend from ZzlosS/tennis:
EXPO_PUBLIC_API_URL=http://localhost:8787/v1
# Or the backend's mock server (`npm run mock` there), which serves the routes without /v1:
# EXPO_PUBLIC_API_URL=http://localhost:4010
# On an Android emulator, localhost is the emulator itself; use http://10.0.2.2:8787/v1 instead.

# Crash reports. Empty means Sentry stays off.
EXPO_PUBLIC_SENTRY_DSN=

# Only for EAS builds (dev builds on phones, store builds)
# EAS_PROJECT_ID=
# SENTRY_ORG=
# SENTRY_PROJECT=
